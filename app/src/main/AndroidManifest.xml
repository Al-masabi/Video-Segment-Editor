<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- التطبيق يعمل بدون إنترنت بالكامل (offline-first) -->
    <!-- لا صلاحية إنترنت لأنها غير مطلوبة -->

    <!-- مطلوبة فقط على أندرويد 9 وأقدم (قبل Scoped Storage) لحفظ الفيديو
         بالمعرض. على أندرويد 10+ نستخدم MediaStore بدون أي صلاحية. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".VseApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.VideoSegmentEditor"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VideoSegmentEditor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- خدمة أمامية (Foreground Service) لمعالجة الفيديو في الخلفية
             ستُضاف تفاصيلها في مرحلة لاحقة (Pause/Resume/Cancel) -->

    </application>

</manifest>
